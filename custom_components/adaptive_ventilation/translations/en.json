  "issues": {
    "outdoor_sensor_in_sun": {
      "title": "Outdoor sensor probably in the sun",
      "description": "The outdoor sensor reads {delta} K above the weather service while the sun is up. That skews every ΔT comparison. Move it into the shade, or use the weather entity as the temperature source."
    },
    "no_hourly_forecast": {
      "title": "No hourly forecast",
      "description": "The configured weather entity does not deliver an hourly forecast. Without it there are no tipping points, no 24 h plan and no pre-cooling. Pick a weather integration that supports hourly forecasts."
    },
    "no_rooms_configured": {
      "title": "No rooms configured",
      "description": "Adaptive Ventilation needs at least one room. Add one via the \"Add room\" subentry on the integration page."
    },
    "no_windows_configured": {
      "title": "No windows configured",
      "description": "Without windows there is nothing to recommend. Add at least one window with a contact sensor."
    },
    "missing_entity": {
      "title": "Configured entity is missing",
      "description": "An entity used by Adaptive Ventilation no longer exists: {entity_id}. Update the configuration."
    }
  },
